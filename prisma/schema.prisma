generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id
  email     String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  campaigns Campaign[]
}

model Type {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  campaigns Campaign[]
}

model Tag {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  campaigns Campaign[] @relation("CampaignTags")
}

model Chain {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  campaigns Campaign[]
}

model Campaign {
  id              Int       @id @default(autoincrement())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  description     String
  expiresAt       DateTime?
  featured        Boolean   @default(false)
  image           String
  isAd            Boolean   @default(false)
  isNew           Boolean   @default(false)
  title           String
  value           String
  longDescription String
  totalAmount     Int
  airdropUrl      String?
  companyUrl      String?
  kaitoUrl        String?
  xUrl            String?
  typeId          Int
  type            Type      @relation(fields: [typeId], references: [id])
  chainId         Int?
  chain           Chain?    @relation(fields: [chainId], references: [id])
  tags            Tag[]     @relation("CampaignTags")
}