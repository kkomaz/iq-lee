generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id // Privy user ID
  email     String?    @unique
  campaigns Campaign[] // One-to-many relation with campaigns
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Campaign {
  id             Int      @id @default(autoincrement())
  title          String   // Renamed from 'name'
  description    String   // Short description
  longDescription String   // Added
  expiresAt      DateTime // Added
  value          String   // Added
  image          String   // Added
  featured       Boolean  @default(false) // Added
  isNew          Boolean  @default(false) // Added
  isAd           Boolean  @default(false) // Added
  userId         String   // Foreign key to User
  user           User     @relation(fields: [userId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}